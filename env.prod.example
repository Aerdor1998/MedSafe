# =============================================================================
# MedSafe - Production Environment Configuration
# DEPLOY_ROADMAP Section 5: Deploy configuration
# =============================================================================
#
# IMPORTANT: Copy this file to .env and configure ALL required values
# DO NOT commit the actual .env file to git!
#
# Generate secrets with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# =============================================================================

# =============================================================================
# SECURITY (REQUIRED - No defaults in production!)
# =============================================================================

# Execution environment. CRITICAL: without ENVIRONMENT=production the app falls
# back to the "development" default in backend/app/config.py and EVERY production
# validation becomes a no-op — default-secret blocking, secret entropy checks,
# Postgres password length, DEBUG blocking and mandatory log redaction
# (config.py:280-452). docker-compose.prod.yml also sets this explicitly for the
# api/worker services; keep both in sync.
ENVIRONMENT=production

# Application secret key (min 32 chars)
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# JWT secret for authentication (min 32 chars)
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# JWT configuration
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Initial admin password, consumed by the alembic migrations that seed/rotate the
# default admin user (they run inside the api container). REQUIRED on the first
# deploy and whenever the seeded admin still exists — migration 006 FAILS if empty
# (alembic/versions/20260114_0900_006_add_users_and_audit.py:29-32). Never logged.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
ADMIN_INITIAL_PASSWORD=

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================

POSTGRES_DB=medsafe
POSTGRES_USER=medsafe

# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=

# =============================================================================
# REDIS (REQUIRED)
# =============================================================================

# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
REDIS_PASSWORD=

# =============================================================================
# CORS/HOSTS (REQUIRED - NEVER use wildcard in production!)
# =============================================================================

# Allowed origins for CORS - comma separated, NO wildcards!
# Example: https://medsafe.yourdomain.com
ALLOWED_ORIGINS=https://medsafe.yourdomain.com

# Allowed hosts - comma separated
ALLOWED_HOSTS=medsafe.yourdomain.com

# =============================================================================
# OLLAMA / LLM CONFIGURATION
# =============================================================================

# Ollama.
# NOTE: docker-compose.prod.yml hardcodes OLLAMA_HOST=http://host.docker.internal:11434
# for api/worker because this deployment uses the HOST-NATIVE Ollama (GPU via WSL2),
# not the container. The value here only applies to processes run outside compose.
# Use http://ollama:11434 if you switch back to the containerized profile.
OLLAMA_HOST=http://host.docker.internal:11434
# medgemma:latest is the adopted clinical model (gate met on 2026-07-13, re-confirmed
# 2026-07-25: 17/17, recall 1.0, false alarm 0.0). Do NOT change without re-running
# evals/run_eval.py — see evals/README.md.
OLLAMA_LLM=medgemma:latest
OLLAMA_VLM=qwen2.5vl:7b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Cloud Ollama (optional - if using cloud models)
# Get API key from: https://ollama.com/settings/keys
# OLLAMA_API_KEY=
# OLLAMA_CLOUD=gpt-oss:120b-cloud

# GPU Configuration (adjust based on your hardware)
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=35
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=2
NVIDIA_VISIBLE_DEVICES=all

# =============================================================================
# RATE LIMITING (REQUIRED for production)
# =============================================================================

# Use Redis for distributed rate limiting
# Format: redis://:<password>@redis:6379/0
RATE_LIMIT_STORAGE=redis://:${REDIS_PASSWORD}@redis:6379/0

# =============================================================================
# MONITORING
# =============================================================================

# Grafana admin password
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
GRAFANA_PASSWORD=
GRAFANA_USER=admin

# pgAdmin (optional - only for debug profile)
PGADMIN_EMAIL=admin@medsafe.com
PGADMIN_PASSWORD=

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Legacy V1 API (disable after migration)
ENABLE_LEGACY_V1=false
LEGACY_V1_SUNSET_DATE=2025-03-01
LOG_DEPRECATED_USAGE=true

# Anonymous (unauthenticated) analysis.
# SECURITY: keep false in production. When true, POST /api/v2/analyze and the vision
# endpoint skip the 401 gate (routers/langgraph.py:334-338, routers/vision.py:36-40),
# leaving an LLM-backed endpoint open to anyone. Confirmed OFF for production by the
# project owner on 2026-07-25. Per CLAUDE.md this may only be flipped to true with
# explicit owner authorization.
ALLOW_ANONYMOUS_ANALYSIS=false

# Human-in-the-loop review queue (LangGraph interrupt + PostgresSaver resume).
# Must match between the api and worker services.
MEDSAFE_ENABLE_HITL=true

# Analysis-worker shutdown/recovery knobs (backend/app/workers/analysis_worker.py).
# Seconds the in-flight analysis gets to finish after SIGTERM (code default 300.0,
# analysis_worker.py:38). Keep BELOW the worker's 360s stop_grace_period in
# docker-compose.prod.yml, or SIGKILL lands before the drain finishes.
MEDSAFE_WORKER_DRAIN_TIMEOUT=300.0
# Seconds without heartbeat before a "running" job is considered orphaned and
# requeued (code default 600.0, analysis_worker.py:32).
MEDSAFE_WORKER_STALE_JOB_SECONDS=600.0

# Content-Security-Policy strict mode. When false the CSP still ships 'unsafe-inline'
# for scripts and styles (middleware/security.py:102,121). Turn on only after
# confirming the frontend uses the nonce — migration path at security.py:13-21.
# Wired: docker-compose.prod.yml passes this to the api container (default false,
# the code's own safe default at middleware/security.py:42).
CSP_STRICT_MODE=false

# =============================================================================
# METRICS
# =============================================================================

ENABLE_METRICS=true
# Crie o Docker secret usado pela API e pelo Prometheus (não colocar o valor aqui):
#   mkdir -p secrets/prometheus
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))' \
#     > secrets/prometheus/metrics_auth_token

# =============================================================================
# UPLOAD CONFIGURATION
# =============================================================================

MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# =============================================================================
# EXTERNAL APIS
# =============================================================================

ENABLE_RXNORM=true
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# ============================================================================
# ERROR TRACKING (SDK compatível com Sentry — GlitchTip self-hosted)
# ============================================================================
# Vazio = desabilitado (no-op). Para usar o GlitchTip local:
#   1. docker compose -f docker-compose.glitchtip.yml up -d
#   2. Acesse http://localhost:8090, crie organização/projeto e copie o DSN
#   3. Cole o DSN abaixo (api e worker leem via env)
# Trocar de backend no lançamento = trocar apenas este DSN.
SENTRY_DSN=
# Amostragem de performance/tracing (0.0 = só erros)
SENTRY_TRACES_SAMPLE_RATE=0.0
