# MedSafe - Variáveis de Ambiente (PostgreSQL)
# Este arquivo é EXEMPLO. Não coloque segredos reais aqui.
# Use placeholders e configure valores reais em `.env` (gitignored).
#
# SECURITY: Em staging/produção, valores marcados com CHANGE_ME são BLOQUEADOS!
# A aplicação NÃO inicia se detectar secrets default em ambientes não-development.

# ============================================================================
# ENVIRONMENT - OBRIGATÓRIO CONFIGURAR EM STAGING/PRODUÇÃO
# ============================================================================
# Valores: development, staging, production
# SECURITY: Em staging e production, todas validações de segurança são aplicadas
ENVIRONMENT=development

# ============================================================================
# BACKEND
# ============================================================================
PORT=9000
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# POSTGRESQL
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medsafe
POSTGRES_USER=medsafe
POSTGRES_PASSWORD=CHANGE_ME

# Database URL - PostgreSQL
DATABASE_URL=postgresql://medsafe:CHANGE_ME@localhost:5432/medsafe

# ============================================================================
# OLLAMA - IA (Local)
# ============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM=qwen3:8b
OLLAMA_VLM=qwen2.5vl:7b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# ============================================================================
# OLLAMA - Configuração de GPU
# ============================================================================
# SECURITY FIX: Valores seguros para GPU
# Ajuste conforme seu hardware (verificar com nvidia-smi)
OLLAMA_NUM_GPU=1              # Número de GPUs a usar (1 = seguro)
OLLAMA_GPU_LAYERS=35          # Camadas na GPU (35 = ~6GB VRAM para modelos 7B)
OLLAMA_MAX_LOADED_MODELS=1    # Modelos simultâneos na VRAM
OLLAMA_NUM_PARALLEL=2         # Requisições paralelas
NVIDIA_VISIBLE_DEVICES=all    # GPUs visíveis (0, 1, all, etc)

# Perfis de GPU sugeridos:
# - GPU 4GB:  OLLAMA_GPU_LAYERS=20, use modelos 1.5B-3B
# - GPU 6GB:  OLLAMA_GPU_LAYERS=28, use modelos 3B-7B
# - GPU 8GB:  OLLAMA_GPU_LAYERS=35, use modelos 7B-8B
# - GPU 12GB: OLLAMA_GPU_LAYERS=50, use modelos até 14B
# - GPU 24GB: OLLAMA_GPU_LAYERS=99, use modelos até 70B

# ============================================================================
# OLLAMA - Cloud API (Opcional)
# ============================================================================
# Para usar modelos cloud do Ollama (deepseek, etc), obtenha uma API key em:
# https://ollama.com/settings/keys
# OLLAMA_API_KEY=CHANGE_ME
#
# Cloud é OPT-IN (deixe vazio para usar só local).
# Exemplo:
# OLLAMA_CLOUD=gpt-oss:120b-cloud

# ============================================================================
# SEGURANÇA - Secrets Gerados
# ============================================================================
SECRET_KEY=CHANGE_ME_MIN_32_CHARS
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ============================================================================
# FASE 1.1: Configurações Avançadas de JWT
# ============================================================================
# Algoritmos permitidos (whitelist de segurança NIST/OWASP)
# Valores válidos: HS256,HS384,HS512,RS256,RS384,RS512,ES256,ES384,ES512,PS256,PS384,PS512
JWT_ALLOWED_ALGORITHMS=HS256,HS384,HS512

# Key rotation: versão da chave (incrementar para invalidar TODOS os tokens antigos)
# Use em caso de comprometimento de secret ou rotação programada
JWT_KEY_VERSION=1

# Token revocation: habilitar blacklist via Redis
# Requer Redis disponível - se desabilitado, tokens não podem ser revogados individualmente
JWT_ENABLE_REVOCATION=true

# TTL para JTIs na blacklist Redis (segundos) - deve ser >= JWT_REFRESH_EXPIRE_DAYS * 86400
JWT_BLACKLIST_TTL=604800

# ============================================================================
# CORS - Desenvolvimento Local
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8050,http://127.0.0.1:8000

# ============================================================================
# SECURITY - Hosts Permitidos (TrustedHostMiddleware)
# ============================================================================
# SECURITY FIX: Lista de hosts válidos (NÃO usar "*" em produção!)
ALLOWED_HOSTS=localhost,127.0.0.1
# Para produção, adicione seu domínio:
# ALLOWED_HOSTS=medsafe.example.com,www.medsafe.example.com

# ============================================================================
# SECURITY - Content Security Policy (CSP)
# ============================================================================
# CSP_STRICT_MODE: Remove 'unsafe-inline' from CSP (requires frontend build pipeline)
# - false (default): allows unsafe-inline + nonces (backwards compatible)
# - true: nonces only (hardened, requires build step for inline scripts/styles)
CSP_STRICT_MODE=false

# HSTS: Enable HTTP Strict Transport Security
# Disable for development if needed (not recommended for production)
HSTS_ENABLED=true

# CSP_REPORT_URI: URL to receive CSP violation reports (optional)
# Example: CSP_REPORT_URI=https://your-reporting-endpoint.com/csp-reports
# CSP_REPORT_URI=

# ============================================================================
# REDIS (Opcional para desenvolvimento)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# UPLOAD DE ARQUIVOS
# ============================================================================
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# ============================================================================
# APIs EXTERNAS
# ============================================================================
ENABLE_RXNORM=true
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# ============================================================================
# TELEMETRIA
# ============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# FEATURE FLAGS (Phase 1)
# ============================================================================
# Enable legacy V1 API endpoints (set to false to disable)
ENABLE_LEGACY_V1=false

# Allow anonymous v2 analysis (for demos/dev only; keep false in production)
ALLOW_ANONYMOUS_ANALYSIS=false

# Sunset date for V1 API (ISO format)
LEGACY_V1_SUNSET_DATE=2025-03-01

# Log deprecated API usage
LOG_DEPRECATED_USAGE=true

# ============================================================================
# RATE LIMITING
# ============================================================================
# Storage backend for rate limiting (memory:// for dev, redis:// for prod)
RATE_LIMIT_STORAGE=memory://
# Example for production with Redis:
# RATE_LIMIT_STORAGE=redis://localhost:6379/1

# ============================================================================
# LGPD COMPLIANCE & DATA RETENTION
# ============================================================================
# SECURITY: Habilitar redação automática de PHI/PII em logs (OBRIGATÓRIO em produção)
ENABLE_LOG_REDACTION=true

# Retenção de dados em dias (padrões seguros para compliance médica - CFM Res. 1821/2007)
RETENTION_ANALYSIS_JOBS_DAYS=365
RETENTION_TRIAGES_DAYS=1825
RETENTION_REPORTS_DAYS=1825
RETENTION_HITL_REVIEWS_DAYS=1825
RETENTION_AUDIT_LOGS_DAYS=1825
RETENTION_USER_SESSIONS_DAYS=90
RETENTION_INGEST_JOBS_DAYS=180

# Criptografia de dados em repouso
DATA_ENCRYPTION_AT_REST=true

# ============================================================================
# DATA RETENTION WORKER
# ============================================================================
# Intervalo de execução do worker de retenção (horas)
RETENTION_INTERVAL_HOURS=24

# Executar uma vez e sair (útil para cron jobs)
RETENTION_RUN_ONCE=false
