# =============================================================================
# MedSafe - Production Environment Configuration
# DEPLOY_ROADMAP Section 5: Deploy configuration
# =============================================================================
#
# IMPORTANT: Copy this file to .env and configure ALL required values
# DO NOT commit the actual .env file to git!
#
# Generate secrets with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# =============================================================================

# =============================================================================
# SECURITY (REQUIRED - No defaults in production!)
# =============================================================================

# Application secret key (min 32 chars)
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# JWT secret for authentication (min 32 chars)
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

# JWT configuration
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================

POSTGRES_DB=medsafe
POSTGRES_USER=medsafe

# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=

# =============================================================================
# REDIS (REQUIRED)
# =============================================================================

# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
REDIS_PASSWORD=

# =============================================================================
# CORS/HOSTS (REQUIRED - NEVER use wildcard in production!)
# =============================================================================

# Allowed origins for CORS - comma separated, NO wildcards!
# Example: https://medsafe.yourdomain.com
ALLOWED_ORIGINS=https://medsafe.yourdomain.com

# Allowed hosts - comma separated
ALLOWED_HOSTS=medsafe.yourdomain.com

# =============================================================================
# OLLAMA / LLM CONFIGURATION
# =============================================================================

# Local Ollama (default)
OLLAMA_HOST=http://ollama:11434
OLLAMA_LLM=qwen2.5:7b
OLLAMA_VLM=qwen2.5vl:7b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Cloud Ollama (optional - if using cloud models)
# Get API key from: https://ollama.com/settings/keys
# OLLAMA_API_KEY=
# OLLAMA_CLOUD=gpt-oss:120b-cloud

# GPU Configuration (adjust based on your hardware)
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=35
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=2
NVIDIA_VISIBLE_DEVICES=all

# =============================================================================
# RATE LIMITING (REQUIRED for production)
# =============================================================================

# Use Redis for distributed rate limiting
# Format: redis://:<password>@redis:6379/0
RATE_LIMIT_STORAGE=redis://:${REDIS_PASSWORD}@redis:6379/0

# =============================================================================
# MONITORING
# =============================================================================

# Grafana admin password
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
GRAFANA_PASSWORD=
GRAFANA_USER=admin

# pgAdmin (optional - only for debug profile)
PGADMIN_EMAIL=admin@medsafe.com
PGADMIN_PASSWORD=

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Legacy V1 API (disable after migration)
ENABLE_LEGACY_V1=false
LEGACY_V1_SUNSET_DATE=2025-03-01
LOG_DEPRECATED_USAGE=true

# =============================================================================
# METRICS
# =============================================================================

ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# UPLOAD CONFIGURATION
# =============================================================================

MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# =============================================================================
# EXTERNAL APIS
# =============================================================================

ENABLE_RXNORM=true
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# ============================================================================
# ERROR TRACKING (SDK compatível com Sentry — GlitchTip self-hosted)
# ============================================================================
# Vazio = desabilitado (no-op). Para usar o GlitchTip local:
#   1. docker compose -f docker-compose.glitchtip.yml up -d
#   2. Acesse http://localhost:8090, crie organização/projeto e copie o DSN
#   3. Cole o DSN abaixo (api e worker leem via env)
# Trocar de backend no lançamento = trocar apenas este DSN.
SENTRY_DSN=
# Amostragem de performance/tracing (0.0 = só erros)
SENTRY_TRACES_SAMPLE_RATE=0.0
